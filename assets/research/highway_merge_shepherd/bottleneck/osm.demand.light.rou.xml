<?xml version="1.0" encoding="UTF-8"?>
<routes version="1.16">
    <vTypeDistribution id="hdv_mix">
        <vType tau="0.95" sigma="0.6" speedFactor="1.08" accel="3.0" decel="4.5" minGap="1.5" lcCooperative="0.3" lcAssertive="0.6" impatience="0.7" id="aggressive_car" probability="0.10"/>
        <vType tau="1.1" sigma="0.4" speedFactor="1.0" accel="2.6" decel="4.5" minGap="2.5" lcCooperative="0.6" impatience="0.3" id="normal_car" probability="0.70"/>
        <vType tau="1.5" sigma="0.2" speedFactor="0.92" accel="2.0" decel="3.0" minGap="3.5" lcCooperative="1.0" impatience="0.0" id="cautious_car" probability="0.20"/>
    </vTypeDistribution>
    <vType id="truck" accel="1.3" decel="4.0" sigma="0.5" length="12.0"
           maxSpeed="25.0" minGap="3.0" vClass="truck"/>

    <route id="r0" edges="upstream downstream"/>

    <!-- Light: 2400 veh/h = 2160 car + 240 truck -->
    <flow id="f_car"   type="hdv_mix" route="r0" begin="0" end="900" vehsPerHour="2160" departLane="best" departSpeed="max"/>
    <flow id="f_truck" type="truck" route="r0" begin="0" end="900" vehsPerHour="240"  departLane="best" departSpeed="max"/>
</routes>
