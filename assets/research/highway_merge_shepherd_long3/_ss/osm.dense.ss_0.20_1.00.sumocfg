<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration>
  <input>
    <net-file value="../osm.net.xml.gz"/>
    <route-files value="cell_0.20_1.00.rou.xml"/>
    <additional-files value="../output.dense.add.xml"/>
  </input>
  <output>
    <tripinfo-output value="trip_0.20_1.00.xml"/>
  </output>
  <processing><ignore-route-errors value="true"/><collision.action value="warn"/><time-to-teleport value="-1"/></processing>
  <report><no-step-log value="true"/></report>
</sumoConfiguration>
