<configuration>
    <input>
        <net-file value="wz2to1.net.xml"/>
        <route-files value="wz2to1.example.rou.xml"/>
    </input>
    <time>
        <step-length value="0.5"/>
        <end value="1800"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
    </processing>
</configuration>
