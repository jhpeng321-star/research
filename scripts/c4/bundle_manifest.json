{
  "schema": "c4_bundle_manifest/1",
  "note": "Declarative content of the C4 transfer bundle (built by scripts/c4/pack_bundle.py). Paths under data_root are relative to the data cache (default E:/research-dense/data_cache). Data lands at <C4_HOME>/rd/data_cache/<dest> so configs/data_registry.toml resolves unchanged. Hard filter: any path containing a restricted token (holdout, heldout, cal, calibration, cal_split, sealed, chunk5, j4b, inc1) is dropped and the build aborts if one survives in a tar.",
  "default_policies": ["native", "trajectory"],
  "policy_note": "C4 world-model data = native driving + random direct-output CAV actions only (WM_C4_DESIGN 2.5): window policy 'damping' (CIRCLES) is excluded by default; pass --policies to override.",
  "code_allowlist": ["src/wms/physics/merge_cal.py"],
  "code_allowlist_note": "Code-only exceptions to the token filter: merge_cal.py is the merge-zone physics calibration module imported by wms.physics (no calibration-split data). Everything else matching a restricted token is dropped and listed in BUNDLE_MANIFEST.json.",
  "code": {
    "root_files": ["pyproject.toml", "requirements.txt", "requirements-dev.txt"],
    "dirs": [
      "src",
      "traffic_shepherd",
      "tools",
      "configs",
      "baselines/circles",
      "assets/research/highway_merge_shepherd_long",
      "scenarios/idm",
      "scripts/c4",
      "scripts/box",
      "tests",
      "runs/active/WM-S-C4-20261013"
    ],
    "files": [
      "assets/research/migration_manifest.json",
      "docs/WM_C4_DESIGN.md",
      "docs/EXPERIMENT_RECORD_TEMPLATE.md"
    ],
    "exclude_globs": [
      "**/__pycache__/**", "**/*.pyc", "**/*.bak", "**/*.log", "**/*.pt", "**/*.pth",
      "**/.pytest_cache/**", "**/.ruff_cache/**",
      "tests/golden/**", "tests/planner/**", "tests/equivalence/**",
      "runs/active/WM-S-C4-20261013/bundle/**", "runs/active/WM-S-C4-20261013/fetched/**"
    ],
    "text_lf_suffixes": [".sh"]
  },
  "groups": {
    "lists": {
      "kind": "derived_lists",
      "dest": "data_cache/c4_lists",
      "note": "Policy-filtered copies of the leave-PI/wall-out TRAIN/VAL window lists and of the switching-pack direct-mix windows. The C4 WM config should point at these (the original lists also contain CIRCLES-damping windows).",
      "sources": {
        "windows_train_c4.json": {"from": "lpwo_v3/windows_train_noPI_noWall.json", "filter": "policy"},
        "windows_val_c4.json": {"from": "lpwo_v3/windows_val_noPI_noWall.json", "filter": "policy"},
        "windows_train_direct_mix_c4.json": {"from": "wmn1_switching_train/windows_train_hetdata.json", "filter": "arm:direct-mix"}
      }
    },
    "lpwo_v3": {
      "kind": "plain",
      "dest": "data_cache/lpwo_v3",
      "src": "lpwo_v3",
      "files": ["windows_train_noPI_noWall.json", "windows_val_noPI_noWall.json", "excluded_runs_PI_wall_v3.json"]
    },
    "pack_v3": {
      "kind": "pack",
      "src": "pack_v3",
      "dest": "data_cache/pack_v3",
      "pack_name": "pack_v3",
      "lists": ["lpwo_v3/windows_train_noPI_noWall.json", "lpwo_v3/windows_val_noPI_noWall.json"],
      "filter": "policy"
    },
    "pack_dspeed": {
      "kind": "pack",
      "src": "pack_dspeed",
      "dest": "data_cache/pack_dspeed",
      "pack_name": "pack_dspeed",
      "lists": ["lpwo_v3/windows_train_noPI_noWall.json", "lpwo_v3/windows_val_noPI_noWall.json"],
      "filter": "policy"
    },
    "pack_damping": {
      "kind": "pack",
      "src": "pack_damping",
      "dest": "data_cache/pack_damping",
      "pack_name": "pack_damping",
      "lists": ["lpwo_v3/windows_train_noPI_noWall.json", "lpwo_v3/windows_val_noPI_noWall.json"],
      "filter": "policy",
      "note": "Only the native windows of this pack survive the default policy filter."
    },
    "pack_switching_train": {
      "kind": "pack",
      "src": "wmn1_switching_train/pack_switching_train",
      "dest": "data_cache/wmn1_switching_train/pack_switching_train",
      "pack_name": "pack_switching_train",
      "lists": ["wmn1_switching_train/windows_train_hetdata.json"],
      "filter": "arm:direct-mix"
    },
    "sidecars": {
      "kind": "plain",
      "dest": "data_cache",
      "src": ".",
      "dirs": [
        "sidecars_packv3_v2", "identities_dspeed", "identities_damping",
        "overlay_dspeed", "overlay_damping",
        "wmn1_switching_train/identities_switching_train",
        "wmn1_switching_train/driver_params_switching_train"
      ],
      "files": [
        "wmn1_switching_train/windows_train_hetdata.json",
        "wmn1_switching_train/ACTION_TIMELINE_INDEX_train.json"
      ]
    }
  },
  "checkpoints": [
    {
      "name": "ckpt_r5b",
      "src": "E:/research-dense/runs/active/WM-S-R5B-20261012/box/gpuA/r5b_main_a1/wm_s_best.pt",
      "dest": "data_cache/ckpt_r5b/wm_s_best.pt",
      "expect_sha256_prefix": "6f000331"
    },
    {
      "name": "ckpt_c1fast",
      "src": "ckpt_c1fast/wm_s.pt",
      "dest": "data_cache/ckpt_c1fast/wm_s.pt"
    }
  ],
  "optional_groups": {
    "eval_states": {
      "kind": "plain",
      "dest": "data_cache",
      "src": ".",
      "dirs": ["wallc1_states_v2"],
      "note": "Gate 1 (action fidelity) state sets, ~0.5 GB; off by default (--groups ...,eval_states)."
    },
    "pack_damping_designed": {
      "note": "To ship CIRCLES-damping windows (evaluation of designed controllers only), rerun with --policies native,trajectory,damping."
    }
  }
}
