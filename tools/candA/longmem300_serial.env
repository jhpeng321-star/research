# S-LONGMEM300 qualified serial recipe (one future at a time, measured on gpuR: 15.8 GiB peak, ~75 min/update).
# Requires a config with [run] gpu_memory_fraction = 0.96 (configs/c4_policy14_candA_long300_serial.toml).
WMS_LM300_RECOMPUTE_REWARD=2
WMS_LM300_PAIRBIAS_CKPT=1
WMS_LM300_TRACE=1
WMS_SPEED_FUTURE_WORKERS=1
WMS_SPEED_FUTURE_VJP_SLOTS=1
C4_GPU_MEM_FRACTION=0.96
unset WMS_SPEED_PARALLEL_FORWARD WMS_SPEED_FUTURE_VJP_SLOTS
