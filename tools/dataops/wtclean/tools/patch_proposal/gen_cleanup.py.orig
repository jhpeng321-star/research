        if os.path.exists(up):
            u = item_for(items, up)
            u["origin"].append("owner:userdoc")
            u["class"] = "USERDOC"
            u["kind_hint"] = "file"
            u["userdoc"] = True
    return


def collect_worktrees(notes):
    inv = rj(WTCLEAN + r"\inventory\inventory.json")
    rc = {}
    for f in os.listdir(WTCLEAN + r"\receipts"):
        if f.endswith(".json"):
            try:
                r = rj(os.path.join(WTCLEAN, "receipts", f))
                rc[r["name"]] = r
            except Exception as exc:
                notes.append("wtclean receipt %s unreadable: %s" % (f, exc))
    out, pending = [], []
    for i in inv:
        if i.get("active"):
            continue
        r = rc.get(i["name"])
        if r is None:
            pending.append({"name": i["name"], "class": i["class"], "files": i.get("uploadCount") or 0,
                            "bytes": i.get("uploadBytes") or 0, "path": i["path"]})
            continue
        sens = i.get("skippedSensitive") or []
        out.append({
            "name": i["name"], "path": nrm(i["path"]), "cls": i["class"], "branch": i.get("branch"),
            "head": i.get("head"), "status": r.get("status"),
            "upload_exit": (r.get("upload") or {}).get("exit"), "check_exit": (r.get("check") or {}).get("exit"),
            "dest": r.get("dest"), "list": r.get("listFile") or i.get("listFile"),
            "list_sha256": sha256_of(r.get("listFile") or i.get("listFile") or ""),
            "files": r.get("uploadCount"), "bytes": r.get("uploadBytes"),
            "committed": r.get("committed"), "commit": r.get("commitSha"), "preserve_ref": r.get("preserveRef"),
            "junctions": len(i.get("junctions") or []), "top_reparse": bool(i.get("topReparse")),
            "sens_count": len(sens), "sens": sens if len(sens) <= 60 else [],
            "ts": r.get("timestamp"),
        })
    return out, pending, [i["name"] for i in inv if i.get("active")]


# ---------------------------------------------------------------- keep-local
def keep_local_items():
    mf = DATAOPS + r"\manifests"
    def m(n):
        p = mf + "\\" + n
        return {"manifest": p, "manifest_sha256": sha256_of(p)}
    K = []

    def add(name, src, cache, manifest=None, drive=None, ref_sha=None, old="remove", note="", complete=True,
            expect=None, registry=None):
        d = {"name": name, "source": nrm(src), "cache": cache, "old_policy": old, "note": note,
             "complete": complete, "drive": drive or [], "ref_sha256sums": ref_sha, "registry": registry or name}
        if manifest:
            d.update(m(manifest))
        if expect:
            d["expect"] = expect
        K.append(d)

    # packs: Drive proofs are tried in order; the first that fully verifies counts
    add("pack_v3", r"D:\rd-staging\wmn1_feat\pack_v3", "pack_v3", "pack_v3.md5",
        drive=[{"t": "tar_parts", "remote": "gdrive:research-archive/data/packs/training_pack_v3_k192",
